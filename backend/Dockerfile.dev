# ==============================================================================
# JobCatalyst AI - Development Backend Dockerfile
# ==============================================================================

FROM python:3.15-slim

WORKDIR /app

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PORT=8000

# Install runtime utilities
RUN apt-get update && apt-get install -y --no-install-recommends \
    libpq-dev \
    build-essential \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Install dependencies directly for fast incremental rebuilds
COPY requirements.txt .
RUN pip install --upgrade pip && \
    pip install --no-cache-dir -r requirements.txt

# Note: Source code will be mounted as a volume in development
COPY . .

# Expose API development port
EXPOSE 8000

# Run FastAPI with live hot-reloading
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--reload"]
