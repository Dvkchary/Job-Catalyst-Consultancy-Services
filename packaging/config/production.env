# ==============================================================================
# JobCatalyst AI - Hardened Production Environment Configurations
# ==============================================================================
# Mode and system descriptors
ENVIRONMENT=production
PROJECT_NAME="JobCatalyst AI Production"
LOG_LEVEL=INFO
LOG_JSON_FORMAT=true

# Port bindings
SERVER_HOST=0.0.0.0
SERVER_PORT=8000

# Relational Database Connection (PostgreSQL Cluster)
POSTGRES_HOST=postgres_db
POSTGRES_PORT=5432
POSTGRES_DB=jobcatalyst_prod
POSTGRES_USER=catalyst_admin
# POSTGRES_PASSWORD must be injected securely via secrets management (e.g. HashiCorp Vault / GCP Secret Manager)

# In-Memory Cache and Celery Broker (Redis)
REDIS_HOST=redis
REDIS_PORT=6379
# REDIS_PASSWORD must be injected securely via secrets management

# JWT Token Security (Critical Security parameters)
TOKEN_EXPIRE_MINUTES=60
# SECRET_KEY must be a cryptographically secure hex string of at least 256-bit entropy

# External Payment Integration (Stripe)
STRIPE_WEBHOOK_SECRET=whsec_replace_this_with_your_actual_webhook_signing_secret
# STRIPE_SECRET_KEY must be injected securely

# Large Language Model APIs (LLMs)
# GEMINI_API_KEY is automatically loaded via Server-Side AI integration
# OPENAI_API_KEY (Optional secondary LLM fallback)
# ANTHROPIC_API_KEY (Optional secondary LLM fallback)

# Rate Limiting & Resource Constraints
RATE_LIMIT_PER_MINUTE=60
MAX_UPLOAD_SIZE_MB=15
CELERY_CONCURRENCY=4
