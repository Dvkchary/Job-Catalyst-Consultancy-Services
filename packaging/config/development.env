# ==============================================================================
# JobCatalyst AI - Local Development Environment Configurations
# ==============================================================================
# Mode and system descriptors
ENVIRONMENT=development
PROJECT_NAME="JobCatalyst AI Development"
LOG_LEVEL=DEBUG
LOG_JSON_FORMAT=false

# Port bindings
SERVER_HOST=127.0.0.1
SERVER_PORT=8000

# Relational Database Connection (Local Postgres Container)
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=jobcatalyst
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgrespassword

# In-Memory Cache and Celery Broker (Local Redis Container)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Token Security (Insecure local secrets for developers)
TOKEN_EXPIRE_MINUTES=480
SECRET_KEY=LOCAL_DEV_SECRET_KEY_ENTROPY_MINIMUM_256_BITS_FOR_LOCAL_DEBUGGING

# External Payment Integration (Stripe Sandbox)
STRIPE_WEBHOOK_SECRET=
STRIPE_SECRET_KEY=

# Large Language Model APIs (LLMs)
GEMINI_API_KEY=LOCAL_MOCK_OR_PERSONAL_AI_STUDIO_KEY

# Rate Limiting & Resource Constraints
RATE_LIMIT_PER_MINUTE=9999
MAX_UPLOAD_SIZE_MB=50
CELERY_CONCURRENCY=1
